PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/elan
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Use the project configured in frontend/.env. Firebase Admin uses Application Default Credentials.
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local/adc.json

# Private backend credentials. Leave the key empty to disable remote AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_CONCURRENCY=2
AI_DAILY_ATTEMPTS=100

# Optional model-specific prices for approximate telemetry, in USD per 1M tokens.
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
