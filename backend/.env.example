# Port used by the Express API locally.
PORT=5000

# MongoDB connection string. Use MongoDB Atlas in production.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/elan

# Comma-separated frontend origins allowed to call the API.
# Example for production: https://your-elan-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Use "production" in deployed environments.
NODE_ENV=development

# Private Groq API key used only by the backend AI provider.
# Leave empty in public demos if AI features should be disabled safely.
AI_API_KEY=your_groq_api_key_here
